# ==========================================
# 应用配置
# ==========================================
APP_NAME=AI选品系统
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production

# ==========================================
# 数据库配置
# ==========================================
# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/xuanpin
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=xuanpin

# ==========================================
# API密钥
# ==========================================
# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4-vision-preview
OPENAI_TEXT_MODEL=gpt-4-turbo-preview

# Anthropic Claude (备用)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# ==========================================
# 数据源配置
# ==========================================
# Google Trends (可选，无密钥也能用但有限制)
GOOGLE_TRENDS_API_KEY=

# 爬虫配置
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
SCRAPER_TIMEOUT=30
SCRAPER_MAX_RETRIES=3

# 代理配置（可选）
HTTP_PROXY=
HTTPS_PROXY=
SOCKS_PROXY=

# ==========================================
# 任务队列配置
# ==========================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ==========================================
# 监控配置
# ==========================================
# 每日自动发现新品的时间（24小时制）
AUTO_DISCOVER_TIME=01:00

# 监控更新频率（小时）
MONITORING_INTERVAL=24

# 预警阈值
ALERT_VIDEO_GROWTH_THRESHOLD=50
ALERT_SALES_GROWTH_THRESHOLD=100

# ==========================================
# 存储配置
# ==========================================
# 文件上传路径
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760  # 10MB

# 图片存储
IMAGE_STORAGE_TYPE=local  # local/s3/oss
IMAGE_BASE_URL=http://localhost:8000/static/images

# S3配置（如果使用）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1

# ==========================================
# 评分配置
# ==========================================
# 各维度权重（总和应为100）
WEIGHT_MARKET_DEMAND=10
WEIGHT_FUNCTIONAL_VALUE=10
WEIGHT_EMOTIONAL_VALUE=10
WEIGHT_CONTENT_VALUE=15
WEIGHT_PLEASURE_PAIN=10
WEIGHT_US_MARKET_FIT=10
WEIGHT_SIZE_LOGISTICS=10
WEIGHT_COMPETITION=10
WEIGHT_SUPPLY_PRICING=15

# 评分阈值
SCORE_S_THRESHOLD=85
SCORE_A_THRESHOLD=75
SCORE_B_THRESHOLD=65
SCORE_C_THRESHOLD=55

# ==========================================
# 利润计算配置
# ==========================================
# 默认费率
DEFAULT_PLATFORM_FEE_RATE=0.15  # 15%
DEFAULT_AD_COST_RATE=0.20  # 20%
DEFAULT_RETURN_RATE=0.04  # 4%
DEFAULT_PACKAGING_COST=0.50  # $0.50

# 物流成本计算
SHIPPING_COST_PER_KG=8.00  # $8/kg
WAREHOUSE_FEE_SMALL=0.80  # 小件入库费
WAREHOUSE_FEE_MEDIUM=1.50  # 中件入库费
WAREHOUSE_FEE_LARGE=3.00  # 大件入库费

# CNY to USD 汇率（定期更新）
CNY_TO_USD_RATE=0.14

# ==========================================
# 限流配置
# ==========================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # 秒

# ==========================================
# CORS配置
# ==========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# ==========================================
# 日志配置
# ==========================================
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
LOG_ROTATION=500 MB
LOG_RETENTION=30 days

# ==========================================
# 安全配置
# ==========================================
# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24小时

# 密码加密
PASSWORD_BCRYPT_ROUNDS=12

# ==========================================
# 缓存配置
# ==========================================
CACHE_DEFAULT_TTL=3600  # 1小时
CACHE_ANALYSIS_TTL=86400  # 24小时
CACHE_TRENDS_TTL=3600  # 1小时

# ==========================================
# 开发配置
# ==========================================
# 是否使用模拟数据（开发时）
USE_MOCK_DATA=False

# 是否跳过真实爬虫（开发时）
SKIP_SCRAPING=False

# 是否跳过AI调用（节省成本）
SKIP_AI_ANALYSIS=False
